{
  "name": "deixa",
  "version": "0.0.1",
  "author": "Matheus Caldeira <matheuscardozo4@gmail.com>",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 1300",
    "build": "NODE_ENV=production next build",
    "start": "NODE_ENV=production next start -H 0.0.0.0 -p 1300",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint .",
    "lint:comments": "node scripts/no-comments.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:bundle": "vitest run --config vitest.bundle.config.mts",
    "test:e2e": "pnpm build && tsx tests/e2e/prepare.ts && playwright test",
    "setup:env": "node scripts/setup-env.mjs",
    "infra:up": "docker compose up -d --wait postgres && docker compose up -d kokoro",
    "infra:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/infrastructure/database/migrate-cli.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/seed/main.ts",
    "db:reset": "node scripts/reset-dev-db.mjs && pnpm db:migrate && pnpm db:seed",
    "fixtures:plans": "tsx --env-file=.env scripts/generate-plan-fixtures.ts",
    "fixtures:catalog": "tsx --env-file=.env scripts/generate-catalog-fixture.ts",
    "screenshots": "node scripts/screenshots.mjs",
    "desktop:check": "cd src-tauri && PATH=\"$HOME/.cargo/bin:$PATH\" cargo check",
    "desktop:run": "cd src-tauri && PATH=\"$HOME/.cargo/bin:$PATH\" cargo run",
    "desktop:server": "node scripts/build-desktop-server.mjs",
    "desktop:build": "pnpm desktop:server && PATH=\"$HOME/.cargo/bin:$PATH\" tauri build --bundles app",
    "desktop:installer": "pnpm desktop:server && PATH=\"$HOME/.cargo/bin:$PATH\" tauri build"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "next": "16.4.0",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
